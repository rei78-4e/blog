---
// src/pages/index.astro
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import externalJson from "../data/external.json";
import { blogPath } from "../utils/paths";

const postsP = getCollection("blog");

const external = externalJson as ExternalPost[];

type ExternalPost = {
  id: string;
  title: string;
  date: string;
  url: string;
  description?: string;
  tags: string[];
  published: boolean;
};

type BlogItem = {
  id: string;
  data: {
    title: string;
    date: Date;
    description?: string;
    tags?: string[];
    published?: boolean;
    url?: string;
  };
};

const externalPosts: BlogItem[] = external.map((item) => ({
  id: item.url,
  data: {
    title: item.title,
    date: new Date(item.date),
    description: item.description?.trim() || undefined,
    tags: item.tags,
    published: true,
    url: item.url,
  },
}));

const posts = await postsP;
const astroPosts: BlogItem[] = posts.map((post) => ({
  id: post.id,
  data: {
    title: post.data.title,
    date: post.data.date,
    description: post.data.description?.trim() || undefined,
    tags: post.data.tags,
    published: post.data.published,
    url: blogPath(`/${post.id.split("/")[0]}/`),
  },
}));

const sorted = [...astroPosts, ...externalPosts]
  .filter((post) => post.data.published !== false)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<MainLayout
  title="Compute on Snails"
  description="Compute on Snails"
  ogImage={blogPath("/og/index.png")}
>
  <form
    class="article-search"
    action={blogPath("/search/")}
    method="get"
    role="search"
  >
    <label class="sr-only" for="article-search-query">
      Search article titles, text and URLs with a regular expression
    </label>
    <div class="article-search-field">
      <svg
        class="article-search-icon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
      >
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4.25 4.25"></path>
      </svg>
      <input
        id="article-search-query"
        name="q"
        type="search"
        inputmode="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search articles…"
      />
      <button type="submit">Search</button>
    </div>
  </form>
  <section id="article-index">
    <h2>Articles</h2>
    <ul class="article-list">
      {
        sorted.map((post) => (
          <li class="article-item">
            <a
              href={post.data.url}
              class="article-title link--underline-accent"
            >
              {post.data.title}
            </a>

            {post.data.description && (
              <p class="article-description">{post.data.description}</p>
            )}

            <div class="article-meta">
              {post.data.tags?.map((tag) => (
                <span class="tag">{tag}</span>
              ))}

              <time>{dateFormatter.format(post.data.date)}</time>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</MainLayout>

<style>
  h2 {
    font-size: 1.8rem;
  }

  .article-search {
    margin: 2rem 0 2.25rem;
  }

  .article-search-field {
    position: relative;
    display: flex;
    align-items: center;
    border: 1px solid var(--line-color);
    border-radius: 12px;
    background: var(--table-bg);
    transition: border-color 0.2s ease;
  }

  .article-search-field:hover {
    border-color: var(--text-muted);
  }

  .article-search-field:focus-within {
    border-color: var(--accent);
  }

  .article-search-icon {
    position: absolute;
    left: 1rem;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--text-muted);
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    pointer-events: none;
  }

  .article-search input {
    width: 100%;
    min-width: 0;
    border: 0;
    border-radius: inherit;
    padding: 0.9rem 5.25rem 0.9rem 3rem;
    background: transparent;
    color: var(--text);
    font: 500 1rem var(--base-fonts-mono);
  }

  .article-search input:focus-visible {
    outline: none;
  }

  .article-search input::placeholder {
    color: var(--text-muted);
    opacity: 0.85;
  }

  .article-search button {
    position: absolute;
    right: 0.75rem;
    border: 1px solid var(--line-color);
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 0.15rem 0.4rem;
    background: var(--table-stripe-bg);
    color: var(--text-muted);
    font: 0.72rem var(--base-fonts-mono);
    cursor: pointer;
  }

  .article-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line-color);
  }

  .article-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "title meta"
      "description meta";
    column-gap: 1rem;
    padding: 0.9rem 0.25rem;
    border-bottom: 1px solid var(--line-color);
  }

  /* 下線まわりはglobal.cssの.link--underline-accentを使用 */
  .article-title {
    grid-area: title;
    justify-self: start;
    min-width: 0;
    max-width: 100%;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .article-title:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .article-description {
    grid-area: description;
    margin: 0.2rem 0 0;
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .article-meta {
    grid-area: meta;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    align-self: center;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  time {
    min-width: 5.5rem;
    margin-left: 0.4rem;
    color: var(--text-muted);
    font-size: inherit;
    text-align: left;
    white-space: nowrap;
  }

  /* 共通部分はglobal.cssの.tags / .tagを使用 */
  .tags {
    margin-left: 0.5rem;
  }

  .tag {
    font-size: inherit;
    font-weight: 500;
    margin-left: 0.4rem;
  }

  @media (max-width: 640px) {
    .article-item {
      grid-template-columns: 1fr;
      grid-template-areas:
        "title"
        "description"
        "meta";
      padding: 0.8rem 0;
    }

    .article-meta {
      justify-content: flex-start;
      width: 100%;
      margin-top: 0.3rem;
    }

    time {
      margin-left: auto;
    }
  }
</style>
