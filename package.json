{
  "name": "rei78-4e-blog",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/prompts": "^2.4.9",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1"
  },
  "scripts": {
    "dev": "npm run dev -w @rei78-4e/blog & npm run dev -w @rei78-4e/me & wait",
    "dev:blog": "npm run dev -w @rei78-4e/blog",
    "dev:me": "npm run dev -w @rei78-4e/me",
    "build": "npm run build:blog && npm run build:me",
    "build:blog": "npm run build -w @rei78-4e/blog",
    "build:me": "npm run build -w @rei78-4e/me",
    "preview": "npm run build && python3 -m http.server 8000 --directory dist",
    "typecheck": "npm run typecheck -w @rei78-4e/blog",
    "preview:blog": "npm run preview -w @rei78-4e/blog",
    "cf-dev:blog": "npm run cf-dev -w @rei78-4e/blog",
    "astro:blog": "npm run astro -w @rei78-4e/blog --",
    "tags": "npm run tags -w @rei78-4e/blog --",
    "slug": "npm run slug -w @rei78-4e/blog --",
    "tags:check": "npm run tags:check -w @rei78-4e/blog",
    "prepare:git": "npm run prepare:git -w @rei78-4e/blog --"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  }
}
